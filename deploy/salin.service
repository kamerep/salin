[Unit]
Description=Salin translator (FastAPI + static frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=salin
Group=salin
EnvironmentFile=/etc/salin/salin.env
WorkingDirectory=/opt/salin/app/backend
ExecStart=/opt/salin/venv/bin/uvicorn --factory salin.main:create_app --host ${SALIN_BIND} --port ${SALIN_PORT} --no-access-log --no-server-header
Restart=on-failure
RestartSec=3
UMask=0077

# Hardening: the service can only write its database and its env file.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/salin /etc/salin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
